# Copy to .env and fill in real values. .env is gitignored.

# App under test
BASE_URL=https://app-dev.trytemelio.com/

# Foundation used for TC12's direct-URL permission check (see README "Setup").
FOUNDATION_ID=

# Credentials used ONLY by `npm run auth:admin` / `npm run auth:user` to capture a
# storageState session once (playwright/.auth/admin.json, playwright/.auth/user.json).
# No test spec reads these directly, and they are never committed.
ADMIN_EMAIL=
ADMIN_PASSWORD=
USER_EMAIL=
USER_PASSWORD=

# Search term expected to return at least one match in the "Find Entity" (every.org)
# data source, used by TC13.
ORG_SEARCH_TERM=Test
